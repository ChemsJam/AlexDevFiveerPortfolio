---
import Layout from "../layouts/Layout.astro"
---

<Layout>
    <div class="row d-flex services-section">
        <div class="col-2"></div>
        <div class="col-8">
            <div class="row">
                <div class="col-3">
                    <center>
                        <h3>My Services</h3>
                    </center>
                </div>
                <hr>
                <div class="row">
                        <div class="col-7 mt-5 align-self-start services-card">
                            <div class="row">
                                <div class="col-5 text-start">
                                    <h4>Backend REST API Development</h4>
                                <p>
                                    I develop clean and well-structured REST APIs for small to medium applications, including authentication, database integration, and API documentation.
                                </p>
                                </div>
                                <div class="col-7 d-flex justify-content-center">
                                    <img src="/images/ServiceDashboardExample.webp" alt="ServiceDashboardExample" class="img-fluid border rounded">
                                </div>
                            </div>
                        </div>
                        <div class="col-5"></div>
                        <div class="col-5"></div>
                        <div class="col-7 mt-5 align-self-center services-card">
                            <div class="row">
                                <div class="col-5 text-start">
                                    <h4>Backend REST API Development</h4>
                                <p>
                                    I develop clean and well-structured REST APIs for small to medium applications, including authentication, database integration, and API documentation.
                                </p>
                                </div>
                                <div class="col-7 d-flex justify-content-center">
                                    <img src="/images/ServiceDashboardExample.webp" alt="ServiceDashboardExample" class="img-fluid border rounded">
                                </div>
                            </div>
                        </div>
                    </div>
            </div>
        </div>
    </div>
</Layout>