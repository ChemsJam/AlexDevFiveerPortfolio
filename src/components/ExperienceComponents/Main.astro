
---
import HarmanCard from "./ExperienceCards/HarmanCard.astro"
import EmkodeCard from "./ExperienceCards/EmkodeCard.astro"
import FiraCard from "./ExperienceCards/FiraCard.astro"
import ControlItCard from "./ExperienceCards/ControlItCard.astro"
import FiraCardExternalSupport from "./ExperienceCards/FiraCardExternalSupport.astro"
import SocialServiceCard from "./ExperienceCards/SocialServiceCard.astro"

---

<div class="Hero p-3 p-md-3">
    
    <div class="row d-flex justify-content-center align-items-center">
        
        <div class="col-12 col-md-10 pt-md-5">
            <div class="about-me-section translate-left p-3 p-md-5">
                <div class="row d-flex justify-content-center align-items-center about-me translate-up">
                    <div class="col-12 col-md-3 col-lg-4 mb-3 d-flex justify-content-center align-items-center">
                        <div class="flip-card">
                        <div class="flip-card-inner">
                            <div class="flip-card-front">
                                <img src="/images/JohanHarman.jpeg" alt="Johan Harman" class="img-fluid" />
                            </div>
                            <div class="flip-card-back">
                                <img src="/images/JohanChibi.jpg" alt="Johan Harman" class="img-fluid" />
                            </div>
                        </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-9 col-lg-8">
                    <h4>Hello I am <strong> Johan Alejandro Ontiveros Alfaro</strong></h4>
                    <p>
                        I see myself as a future FullStack developer, and I am focused on learning to apply django in the backend and the use of React in frontend.
                    </p>
                    <hr>
                        <div class="section">
                            <div class="skills">
                                <p>
                                    Some of my technical skills:
                                </p>
                                <ul>
                                    <li>Lenguajes: "Spanish: native" and "English: B1".</li>
                                    <li>Programming languages: JavaScript, Python and PHP</li>
                                    <li>Frameworks: Django and Symfony</li>
                                    <li>Libraries: React, JQuery, ChartJS</li>
                                    <li>DataBases: MySQL, MariaDB, firebase and SQLServer</li>
                                    <li>Im learning: Django, React (Vite), Astro, PostgreSQL and SQLServer</li>
                                </ul>
                            </div>
                           
                        </div>
                    </div>
                    <div class="col-10">
                       <div class="row d-flex justify-content-center align-items-center mt-5">
                            <div class="col-12 col-sm-6 d-flex justify-content-center align-items-center">
                                <button class="cv-button mb-3 p-1">Download Spanish CV</button>
                            </div>
                            <div class="col-12 col-sm-6 d-flex justify-content-center align-items-center">
                                <button class="cv-button mb-3 p-1">Download English CV</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="work-experience-section translate-right mt-3 mt-md-5 p-3 p-md-5">
                <h2 class="text-center mb-4">Work Experience</h2>
                <div class="experience-container">
                    
                    <!-- CAROUSEL DESKTOP (3 cards por slide) -->
                    <div id="carouselDesktop" class="carousel slide d-none d-lg-block" data-bs-ride="carousel">
                        <div class="carousel-indicators">
                            <button type="button" data-bs-target="#carouselDesktop" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                            <button type="button" data-bs-target="#carouselDesktop" data-bs-slide-to="1" aria-label="Slide 2"></button>
                        </div>
                        <div class="carousel-inner">
                            <div class="carousel-item active" >
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <SocialServiceCard />
                                    </div>
                                    <div class="col-md-4">
                                        <HarmanCard />
                                    </div>
                                    <div class="col-md-4">
                                        <EmkodeCard />
                                    </div>
                                </div>
                            </div>
                            <div class="carousel-item">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <FiraCard />
                                    </div>
                                    <div class="col-md-4">
                                        <ControlItCard />
                                    </div>
                                    <div class="col-md-4">
                                        <FiraCardExternalSupport />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselDesktop" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselDesktop" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>

                    <!-- CAROUSEL MÓVIL (1 card por slide) -->
                    <div id="carouselMobile" class="carousel slide d-lg-none" data-bs-ride="carousel" >
                        <div class="carousel-indicators" >
                            <button type="button" data-bs-target="#carouselMobile" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                            <button type="button" data-bs-target="#carouselMobile" data-bs-slide-to="1" aria-label="Slide 2"></button>
                            <button type="button" data-bs-target="#carouselMobile" data-bs-slide-to="2" aria-label="Slide 3"></button>
                            <button type="button" data-bs-target="#carouselMobile" data-bs-slide-to="3" aria-label="Slide 4"></button>
                            <button type="button" data-bs-target="#carouselMobile" data-bs-slide-to="4" aria-label="Slide 5"></button>
                            <button type="button" data-bs-target="#carouselMobile" data-bs-slide-to="5" aria-label="Slide 6"></button>
                        </div>
                        <div class="carousel-inner"  >
                            <div class="carousel-item active" data-bs-interval="3000">
                                <div class="row">
                                    <div class="col-12 experience-card">
                                        <SocialServiceCard />
                                    </div>
                                </div>
                            </div>
                            <div class="carousel-item" data-bs-interval="3000">
                                <div class="row">
                                    <div class="col-12 experience-card">
                                        <HarmanCard />
                                    </div>
                                </div>
                            </div>
                            <div class="carousel-item" data-bs-interval="3000">
                                <div class="row">
                                    <div class="col-12 experience-card">
                                        <EmkodeCard />
                                    </div>
                                </div>
                            </div>
                            <div class="carousel-item" data-bs-interval="3000">
                                <div class="row">
                                    <div class="col-12 experience-card">
                                        <FiraCard />
                                    </div>
                                </div>
                            </div>
                            <div class="carousel-item" data-bs-interval="3000">
                                <div class="row">
                                    <div class="col-12 experience-card">
                                        <ControlItCard />
                                    </div>
                                </div>
                            </div>
                            <div class="carousel-item" data-bs-interval="3000">
                                <div class="row">
                                    <div class="col-12 experience-card">
                                        <FiraCardExternalSupport />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselMobile" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselMobile" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>

                </div>
            </div>
    </div>
</div>